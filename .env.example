APP_NAME="CHED ONSE KMIS"
APP_SUBTITLE="Knowledge Management Information System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=default

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=records
QUEUE_CONNECTION=redis

# CACHE_STORE: Use 'redis' for production for best cache performance
# Use 'database' for local development if Redis is not available
# CACHE_STORE: Use 'redis' for production for best cache performance
# For simple local development without Redis you may set:
#   CACHE_STORE=file
# or use `array` for an ephemeral per-process cache (resets each request).
# Use 'database' only if you have run the cache table migration.
CACHE_STORE=redis
# Optional deterministic prefix to namespace keys when using Redis
# e.g. CACHE_PREFIX=laravel-cache-
# If you set CACHE_STORE=file locally, no Redis is required.
# CACHE_PREFIX=

# Cache TTL Configuration
# Lower values for development (1-5 min), higher for production (30-60 min)
# `CACHE_SEARCH_TTL` and `CACHE_TRENDING_TTL` are in minutes. The trending data TTL
# (`CACHE_TRENDING_DATA_TTL`) is in seconds and controls how long trending metadata
# (scores, lists) are retained.
CACHE_SEARCH_TTL=5          # Search suggestions cache duration (minutes)
CACHE_TRENDING_TTL=5       # Trending list cache duration (minutes)
CACHE_TRENDING_DATA_TTL=3600  # Trending data expiry (seconds, default 3600)

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_BROADCAST_CONNECTION=default
## When using Redis for cache, choose which logical DB to use for the cache store.
# This should match any equivalent `REDIS_CACHE_DB` in your `.env` if present.
REDIS_CACHE_DB=0

## Optional: set a deterministic cache prefix used by the app when storing keys in Redis
CACHE_PREFIX=

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="racks@onseched.live"
MAIL_FROM_NAME="${APP_NAME}"

# Resend API Key (Required for production email)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=


# Optional: database-backed cache settings (only used if CACHE_STORE=database)
# Run `php artisan cache:table` and migrate before enabling database cache.
# DB_CACHE_CONNECTION=sqlite
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=cache_locks

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Shared HMAC-SHA256 secret for the OCR webhook callback endpoint.
# Generate with: openssl rand -hex 32
OCR_WEBHOOK_SECRET=
OCR_DEFAULT_LANGUAGE=eng+fil+ceb
OCR_PROCESS_TIMEOUT=300
OCR_PDF_RENDER_TIMEOUT=300
OCR_PDF_DPI=300
OCR_OEM=3
OCR_PSM=3
OCR_FALLBACK_PSM=6,11
OCR_PREPROCESS_ENABLED=true
OCR_PREPROCESS_MIN_WIDTH=1800
SUPERVISOR_OCR_QUEUE=ocr
SUPERVISOR_OCR_SLEEP=5
SUPERVISOR_OCR_TRIES=2
SUPERVISOR_OCR_MAX_TIME=3600
SUPERVISOR_OCR_TIMEOUT=900
SUPERVISOR_OCR_MEMORY=1024
SUPERVISOR_OCR_NUMPROCS=1

VITE_APP_NAME="${APP_NAME}"
VITE_APP_SUBTITLE="${APP_SUBTITLE}"

# Staging superadmin credentials — used by SuperAdminSeeder
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=P@ssw0rd123
